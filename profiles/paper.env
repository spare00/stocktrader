# Paper-trading tuning profile tracked with source so tags preserve runtime
# tuning. Secrets stay in .env. Strategy logic defaults live in config.py /
# strategy env_specs; this file keeps global and per-strategy risk overrides only.

###############################################################################
# Runtime
###############################################################################

EXECUTION_MODE=alpaca_paper
# Basic IEX: 30 trade+quote channels = max 15 symbols when streaming quotes+trades.
# SPY/QQQ/IWM and dynamic mover candidates use bars-only when they are not tradable.
# ALPACA_STREAM_MAX_TRADE_QUOTE_CHANNELS=0 disables the startup check (Algo Trader Plus).

###############################################################################
# Global Targets And Risk
###############################################################################

MAX_HOLD_SECONDS=420

STARTING_CASH=100000
MAX_OPEN_POSITIONS=64
TRADE_COOLDOWN_SECONDS=120

DAILY_MAX_LOSS=500
DAILY_MAX_LOSS_PCT=0.04
# Leave CONSECUTIVE_LOSS_*_COUNT unset to use symbol-count auto scaling.
# CONSECUTIVE_LOSS_PAUSE_COUNT=3
# CONSECUTIVE_LOSS_STOP_COUNT=5

MARKET_REGIME_BYPASS_STRATEGIES=liquidity_scalper,recovery_scale

###############################################################################
# Per-Strategy Risk Overrides
###############################################################################

# Leave unset or 0 to use the global MAX_POSITION_VALUE, MAX_OPEN_POSITIONS,
# MAX_HOLD_SECONDS, and TRADE_COOLDOWN_SECONDS.
STOCH_MACD_MAX_OPEN_POSITIONS=10
STOCH_MACD_MAX_POSITION_VALUE=5000
STOCH_MACD_MAX_HOLD_SECONDS=420
# STOCH_MACD_TRADE_COOLDOWN_SECONDS=0

MACD_MAX_OPEN_POSITIONS=10
MACD_MAX_POSITION_VALUE=3000
MACD_MAX_HOLD_SECONDS=420
MACD_TRADE_COOLDOWN_SECONDS=180

STEADY_INTRADAY_MAX_OPEN_POSITIONS=10
STEADY_INTRADAY_MAX_POSITION_VALUE=3000
STEADY_INTRADAY_MAX_HOLD_SECONDS=1200
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0

BP_MAX_OPEN_POSITIONS=10
BP_MAX_POSITION_VALUE=5000
BP_MAX_HOLD_SECONDS=3600
BP_EARLY_FAILURE_SECONDS=120
BP_EARLY_FAILURE_MIN_MFE_PCT=0.003
# BP_EMA_BEARISH_EXIT_ENABLED=false
# BP_TRADE_COOLDOWN_SECONDS=0

RECOVERY_SCALE_MAX_OPEN_POSITIONS=10
RECOVERY_SCALE_MAX_POSITION_VALUE=3000
RECOVERY_SCALE_MAX_HOLD_SECONDS=12000

###############################################################################
# liquidity_scalper (tape stream)
###############################################################################

# Scalper manages its own tape/risk gates; do not block on ETF regime panic.
LIQUIDITY_SCALPER_MAX_SPREAD_BPS=12
LIQUIDITY_SCALPER_MIN_NET_EDGE_BPS=3
LIQUIDITY_SCALPER_MIN_TAPE_DOLLAR_VOLUME=100000
LIQUIDITY_SCALPER_MIN_TRADE_DOLLAR_VOLUME=10000
LIQUIDITY_SCALPER_MIN_BUY_SELL_RATIO=1.35

###############################################################################
# stoch_macd_reversal
###############################################################################

# stoch_macd_reversal — conditional overbought/volume gates in strategy code handle fishy setups.
# Keep spread/volume floors at defaults; do not blanket-tighten here.
# STOCH_MACD_MIN_VOLUME_RATIO=0.20
# STOCH_MACD_MAX_SPREAD_BPS=20
STOCH_MACD_MIN_HIST_NORM=0.00008  # Up from 0.00005

# Wider stops (more breathing room)
STOCH_MACD_STOP_LOSS_PCT=0.006    # Up from 0.0045
STOCH_MACD_MAX_R_PCT=0.015        # Up from 0.012

# Respect global loss limits
STOCH_MACD_RESPECT_CONSECUTIVE_LOSS_LIMITS=true

# For aggressive profiles:
# Allow overbought expansion
# STOCH_MACD_ALLOW_OVERBOUGHT_EXPANSION=true

# Relax reentry gates
# STOCH_MACD_REENTRY_FRESH_ENABLED=false

# Tighter runner pullback (lock profit faster)
# STOCH_MACD_RUNNER_PULLBACK_PCT=0.004  # Down from 0.006

###############################################################################
# opening_impulse
###############################################################################

# Tighter entry quality
OPENING_IMPULSE_MIN_QUOTES=15
OPENING_IMPULSE_VOLUME_RATIO=2.0
OPENING_IMPULSE_MAX_SPREAD_BPS=12

# Faster profit-taking
OPENING_IMPULSE_PARTIAL_TAKE_PROFIT_PCT=0.006  # 0.6% vs 0.8%
OPENING_IMPULSE_RUNNER_PULLBACK_PCT=0.008     # 0.8% vs 1.2%

# Stricter reentry
OPENING_IMPULSE_REENTRY_MIN_VOLUME_RATIO=1.8

# For more aggressive:
# Allow extended entries
# OPENING_IMPULSE_SKIP_EXTENDED_PCT=0.05  # 5% vs 3%
# OPENING_IMPULSE_MAX_ENTRY_EXTENSION_PCT=0.03  # 3% vs 2%

# Wider pullback tolerance (let runners run)
# OPENING_IMPULSE_PULLBACK_PCT=0.008  # 0.8% vs 0.5%
# OPENING_IMPULSE_RUNNER_PULLBACK_PCT=0.02  # 2% vs 1.2%

# Disable failed continuation gate
# OPENING_IMPULSE_REENTRY_MIN_VOLUME_RATIO=0.0  # Always allow reentry

###############################################################################
# recovery_scale
###############################################################################

