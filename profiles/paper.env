# Paper-trading tuning profile tracked with source so tags preserve runtime
# tuning. Secrets stay in .env. Values from sibling paper servers are folded
# into per-strategy settings where possible so fetches do not wipe their tuning.

###############################################################################
# Runtime
###############################################################################

EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
ALPACA_MARKET_DATA_MODE=rest
AI_REVIEW=false

###############################################################################
# Global Targets And Risk
###############################################################################

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=100000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=64
TRADE_COOLDOWN_SECONDS=120

DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02
# Leave CONSECUTIVE_LOSS_*_COUNT unset to use symbol-count auto scaling.
# CONSECUTIVE_LOSS_PAUSE_COUNT=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
# CONSECUTIVE_LOSS_STOP_COUNT=5

###############################################################################
# Session And Execution Controls
###############################################################################

REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

###############################################################################
# Per-Strategy Risk Overrides
###############################################################################

# Leave unset or 0 to use the global MAX_POSITION_VALUE, MAX_OPEN_POSITIONS,
# MAX_HOLD_SECONDS, and TRADE_COOLDOWN_SECONDS.
STOCH_MACD_MAX_OPEN_POSITIONS=10
STOCH_MACD_MAX_POSITION_VALUE=5000
STOCH_MACD_MAX_HOLD_SECONDS=420
# STOCH_MACD_TRADE_COOLDOWN_SECONDS=0

MACD_MAX_OPEN_POSITIONS=10
MACD_MAX_POSITION_VALUE=5000
MACD_MAX_HOLD_SECONDS=420
MACD_TRADE_COOLDOWN_SECONDS=180

STEADY_INTRADAY_MAX_OPEN_POSITIONS=10
STEADY_INTRADAY_MAX_POSITION_VALUE=5000
STEADY_INTRADAY_MAX_HOLD_SECONDS=1200
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0

###############################################################################
# Strategy Windows
###############################################################################

# For Paper Trading
# Extend from 09:30-10:00 ET to 09:30-15:30 ET
OPENING_IMPULSE_START_MINUTE=0
OPENING_IMPULSE_END_MINUTE=360

# Extend from 09:30-10:15 ET to 09:30-15:30 ET
GAP_AND_GO_START_MINUTE=0
GAP_AND_GO_END_MINUTE=360

# Extend from 10:00-11:30 ET to 10:00-15:30
SPIKE_START_MINUTE=30
SPIKE_END_MINUTE=330

# For opening_impulse adjustment
OPENING_IMPULSE_WINDOW_SECONDS=60
OPENING_IMPULSE_MIN_QUOTES=10
OPENING_IMPULSE_CHANGE_PCT=0.003

###############################################################################
# Strategy: stoch_macd_reversal
###############################################################################

STOCH_MACD_START_MINUTE=0
STOCH_MACD_END_MINUTE=360

# Stoch/MACD reversal buy filters. Sell exits still use the normal stop,
# trailing stop, max-loss, and max-hold rules.
STOCH_MACD_MAX_SPREAD_BPS=20
STOCH_MACD_SUPERTREND_BUFFER_PCT=0.0005
STOCH_MACD_MIN_VOLUME_RATIO=0.20
STOCH_MACD_REENTRY_MAX_K=84
STOCH_MACD_REENTRY_MAX_SUPPORT_EXTENSION_PCT=0.0045

STOCH_MACD_SYMBOL_LOSS_LOCK_COUNT=20
STOCH_MACD_MAX_TRADES_PER_SYMBOL_PER_SESSION=10
STOCH_MACD_STOCH_CROSS_LOOKBACK_BARS=5

STOCH_MACD_ALLOW_OVERBOUGHT_EXPANSION=false
STOCH_MACD_AO_FILTER_ENABLED=true
STOCH_MACD_AO_FAST_PERIOD=5
STOCH_MACD_AO_SLOW_PERIOD=34
STOCH_MACD_AO_RISE_BARS=2
STOCH_MACD_AO_MIN_VALUE=0.0

# 10,1 has been better than 7,3 for current chart-matching tests.
STOCH_MACD_SUPERTREND_PERIOD=10
STOCH_MACD_SUPERTREND_MULTIPLIER=1.0

STOCH_MACD_STOP_GRACE_SECONDS=20
STOCH_MACD_STOP_CONFIRMATIONS=2
STOCH_MACD_STOP_MAX_SPREAD_BPS=30
STOCH_MACD_CATASTROPHIC_STOP_LOSS_PCT=0.01

###############################################################################
# Strategy: macd_early_impulse
###############################################################################

MACD_SYMBOL_LOSS_LOCK_COUNT=3
MACD_MAX_TRADES_PER_SYMBOL_PER_SESSION=4
MACD_BURST_MAX_ENTRIES=1
MACD_BURST_WINDOW_SECONDS=300

###############################################################################
# Strategy: steady_intraday
###############################################################################

STEADY_INTRADAY_SYMBOL_LOSS_LOCK_COUNT=10
STEADY_INTRADAY_MAX_TRADES_PER_SYMBOL_PER_SESSION=10

# 0 is proven better than 0.75 and 1.0 in the latest three-server comparison.
# STEADY_INTRADAY_RUNNER_ATR_MULTIPLE=0

# 1.0 is proven better tna 0.8(default)
STEADY_INTRADAY_POSITION_SIZE_MULTIPLIER=1.0
