# Future live-trading tuning profile. Copy to profiles/live.env when live mode exists.
# Keep this much more conservative than paper until paper results are proven.
EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
AI_REVIEW=false

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.003
MAX_HOLD_SECONDS=300

MAX_POSITION_VALUE=250
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_OPEN_POSITIONS=1
TRADE_COOLDOWN_SECONDS=300
DAILY_MAX_LOSS=50
DAILY_MAX_LOSS_PCT=0.02
CONSECUTIVE_LOSS_PAUSE_COUNT=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=20
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003
