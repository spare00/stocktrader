# Local Alpaca-style mock (paper API + market data). Copy to profiles/test.env.
# Run: PROFILE=test scripts/run_paper.sh   (or TUNING_PROFILE=profiles/test.env ...)
#
# Point the Alpaca SDK at your mock; keep EXECUTION_MODE=alpaca_paper so the
# trading client submits orders to the mock the same way it would to Alpaca paper.

ALPACA_TRADING_BASE_URL=http://127.0.0.1:19901
ALPACA_DATA_BASE_URL=http://127.0.0.1:19902
ALPACA_API_KEY=test
ALPACA_SECRET_KEY=test

EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
# REST avoids binding to real Alpaca websocket URLs when the mock only serves HTTP.
ALPACA_MARKET_DATA_MODE=rest

# Default replay poll. Use 0.5 for high-resolution replay verification.
ALPACA_MARKET_DATA_POLL_SECONDS=1

# Replay mode keeps strategy timing on the mock clock (Alpaca replay or local synthetic data).
# Heartbeats still log status, but they do not advance max-hold/min-hold/cooldowns.
REPLAY_MARKET_DATA=true
REPLAY_USE_MOCK_CLOCK=true
REPLAY_CLOSED_BARS_ONLY=true
REPLAY_CLOCK_TIMEOUT_SECONDS=0.5

# Optional global watchlist shared by all active strategies. Strategy plan tickers remain strategy-local.
SYMBOLS=INTC
AI_REVIEW=false

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=8
TRADE_COOLDOWN_SECONDS=60
# Optional per-strategy overrides. Leave unset or 0 to use the global values above.
# OPENING_IMPULSE_MAX_OPEN_POSITIONS=0
# OPENING_IMPULSE_MAX_POSITION_VALUE=0
# OPENING_IMPULSE_MAX_HOLD_SECONDS=0
# GAP_AND_GO_MAX_OPEN_POSITIONS=0
# GAP_AND_GO_MAX_POSITION_VALUE=0
# GAP_AND_GO_MAX_HOLD_SECONDS=0
# SPIKE_MAX_OPEN_POSITIONS=0
# SPIKE_MAX_POSITION_VALUE=0
# SPIKE_MAX_HOLD_SECONDS=0
# STOCH_MACD_MAX_OPEN_POSITIONS=0
# STOCH_MACD_MAX_POSITION_VALUE=0
# STOCH_MACD_MAX_HOLD_SECONDS=0
# STOCH_MACD_TRADE_COOLDOWN_SECONDS=0
# MACD_MAX_OPEN_POSITIONS=0
# MACD_MAX_POSITION_VALUE=0
# MACD_MAX_HOLD_SECONDS=0
# MACD_TRADE_COOLDOWN_SECONDS=0
# MACD_BURST_MAX_ENTRIES=0
# MACD_BURST_WINDOW_SECONDS=0
# STEADY_INTRADAY_MAX_OPEN_POSITIONS=0
# STEADY_INTRADAY_MAX_POSITION_VALUE=0
# STEADY_INTRADAY_MAX_HOLD_SECONDS=0
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0
# MAHA7_MAX_OPEN_POSITIONS=0
# MAHA7_MAX_POSITION_VALUE=0
# MAHA7_MAX_HOLD_SECONDS=0
# BP_MAX_OPEN_POSITIONS=0
# BP_MAX_POSITION_VALUE=0
# BP_MAX_HOLD_SECONDS=0
# BP_TRADE_COOLDOWN_SECONDS=0
# STEADY_INTRADAY_BREAKDOWN_MIN_HOLD_SECONDS=900
# STEADY_INTRADAY_LOST_VWAP_MIN_HOLD_SECONDS=900
# Market-regime gate defaults to on. Bad-market evidence is intentionally weighted
# heavier than good-market evidence so risk_off/panic reacts faster.
# MARKET_REGIME_ENABLED=true
# MARKET_REGIME_SYMBOLS=SPY,QQQ,IWM
# MARKET_REGIME_RISK_OFF_SCORE=-3
# MARKET_REGIME_BLOCK_SCORE=-7
# MARKET_REGIME_RISK_ON_SCORE=5
# MARKET_REGIME_BELOW_VWAP_WEIGHT=2
# MARKET_REGIME_VWAP_FALLING_WEIGHT=1
# MARKET_REGIME_BELOW_EMA_WEIGHT=2
# MARKET_REGIME_SPY_WEIGHT=1.25
# MARKET_REGIME_QQQ_WEIGHT=1.5
# MARKET_REGIME_IWM_WEIGHT=1
# MARKET_REGIME_BYPASS_STRATEGIES=
DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02
# Leave CONSECUTIVE_LOSS_*_COUNT unset to auto-scale from the active symbol count.
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

OPENING_IMPULSE_START_MINUTE=0
OPENING_IMPULSE_END_MINUTE=360
GAP_AND_GO_START_MINUTE=0
GAP_AND_GO_END_MINUTE=360
SPIKE_START_MINUTE=30
SPIKE_END_MINUTE=330
OPENING_IMPULSE_WINDOW_SECONDS=60
OPENING_IMPULSE_MIN_QUOTES=10
OPENING_IMPULSE_CHANGE_PCT=0.003
