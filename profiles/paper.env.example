# Shared paper-trading profile. Copy to profiles/paper.env and keep this file
# focused on settings that apply across strategies.
#
# Tickers: omit SYMBOLS so `data/<strategy>_plan.json` supplies strategy-local watch lists.
# Set SYMBOLS only in this file or in `.env` for global symbols shared by every active strategy.
# Strategies: set STRATEGIES here/`.env`, pass `-s`, or let the runner prompt.
# Do not `export` in the shell — `scripts/run_paper.sh` clears inherited SYMBOLS and STRATEGIES before loading files.
EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
AI_REVIEW=false

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=8
TRADE_COOLDOWN_SECONDS=120
DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02
CONSECUTIVE_LOSS_PAUSE_COUNT=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
CONSECUTIVE_LOSS_STOP_COUNT=5
REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

# Stoch/MACD reversal buy filters. Sell exits still use the normal stop,
# trailing stop, max-loss, and max-hold rules.
STOCH_MACD_MAX_SPREAD_BPS=20
STOCH_MACD_SUPERTREND_BUFFER_PCT=0.0005
STOCH_MACD_REQUIRE_REGULAR_SUPERTREND=false
STOCH_MACD_MIN_VOLUME_RATIO=0.20
STOCH_MACD_RESPECT_CONSECUTIVE_LOSS_LIMITS=false
