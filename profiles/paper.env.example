# Shared paper-trading profile. Copy to profiles/paper.env and keep this file
# focused on settings that apply across strategies.
#
# Tickers: omit SYMBOLS here so `data/<strategy>_plan.json` (from the selector)
# supplies the watch list. Set SYMBOLS in this file or in `.env` only when you
# want to override the plan (e.g. a short manual list).
EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
AI_REVIEW=false

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=2
TRADE_COOLDOWN_SECONDS=120
DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02
CONSECUTIVE_LOSS_PAUSE_COUNT=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
CONSECUTIVE_LOSS_STOP_COUNT=5
REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

# MAHA7 pullback / reclaim (when STRATEGIES includes maha7_pullback_reclaim)
# Exit stack uses env only — no hardcoded thresholds in strategy code.
# MAHA7_DISABLE_MA7_EXIT=false
# MAHA7_RUNNER_CONFIRM_BREAK_BARS=2
# MAHA7_RUNNER_PEAK_PULLBACK_PCT=0.012
# MAHA7_PARTIAL_R=0.5
# MAHA7_PARTIAL_SIZE=0.5
# MAHA7_TARGET_R=2.0
# MAHA7_HARD_TARGET_R_EXIT=true
# MAHA7_MOVE_STOP_TO_ENTRY_AFTER_PARTIAL=true
# MAHA7_PULLBACK_RECLAIM_MIN_HOLD_SECONDS=120
# Legacy alias (used only if MAHA7_RUNNER_CONFIRM_BREAK_BARS is unset):
# MAHA7_MA7_BREAKDOWN_BARS=2
