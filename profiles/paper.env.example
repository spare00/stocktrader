# Shared paper-trading profile. Copy to profiles/paper.env and keep this file
# focused on settings that apply across strategies.
#
# Tickers: omit SYMBOLS so `data/<strategy>_plan.json` supplies strategy-local watch lists.
# Set SYMBOLS only in this file or in `.env` for global symbols shared by every active strategy.
# Strategies: set STRATEGIES here/`.env`, pass `-s`, or let the runner prompt.
# Do not `export` in the shell - `scripts/run_paper.sh` clears inherited SYMBOLS and STRATEGIES before loading files.

###############################################################################
# Runtime
###############################################################################

EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
AI_REVIEW=false

###############################################################################
# Global Targets And Risk
###############################################################################

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=8
TRADE_COOLDOWN_SECONDS=120

DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02
CONSECUTIVE_LOSS_PAUSE_COUNT=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
CONSECUTIVE_LOSS_STOP_COUNT=5

###############################################################################
# Global Market Regime
###############################################################################

# Enabled by default. Bad-market evidence is intentionally weighted heavier than
# good-market evidence so risk_off/panic reacts faster.
# MARKET_REGIME_ENABLED=true
# MARKET_REGIME_SYMBOLS=SPY,QQQ,IWM
# MARKET_REGIME_RISK_OFF_SCORE=-3
# MARKET_REGIME_BLOCK_SCORE=-7
# MARKET_REGIME_RISK_ON_SCORE=5
# MARKET_REGIME_BELOW_VWAP_WEIGHT=2
# MARKET_REGIME_VWAP_FALLING_WEIGHT=1
# MARKET_REGIME_BELOW_EMA_WEIGHT=2
# MARKET_REGIME_SPY_WEIGHT=1.25
# MARKET_REGIME_QQQ_WEIGHT=1.5
# MARKET_REGIME_IWM_WEIGHT=1
# MARKET_REGIME_BYPASS_STRATEGIES=

###############################################################################
# Session And Execution Controls
###############################################################################

REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

###############################################################################
# Per-Strategy Risk Overrides
###############################################################################

# Leave unset or 0 to use the global MAX_OPEN_POSITIONS and TRADE_COOLDOWN_SECONDS.
# STOCH_MACD_MAX_OPEN_POSITIONS=0
# STOCH_MACD_TRADE_COOLDOWN_SECONDS=0
# MACD_MAX_OPEN_POSITIONS=0
# MACD_TRADE_COOLDOWN_SECONDS=0
# MACD_BURST_MAX_ENTRIES=0
# MACD_BURST_WINDOW_SECONDS=0
# STEADY_INTRADAY_MAX_OPEN_POSITIONS=0
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0

###############################################################################
# Strategy: stoch_macd_reversal
###############################################################################

# Buy filters. Sell exits still use the normal stop, trailing stop, max-loss,
# and max-hold rules.
STOCH_MACD_MAX_SPREAD_BPS=20
STOCH_MACD_SUPERTREND_BUFFER_PCT=0.0005
STOCH_MACD_MIN_VOLUME_RATIO=0.20
STOCH_MACD_REENTRY_MAX_K=84
STOCH_MACD_REENTRY_MAX_SUPPORT_EXTENSION_PCT=0.0045
STOCH_MACD_RESPECT_CONSECUTIVE_LOSS_LIMITS=false
