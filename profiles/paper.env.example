# Paper-trading tuning profile. Copy to profiles/paper.env and edit freely while testing.
EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
STRATEGIES=opening_impulse
SYMBOLS=AAPL,MSFT,NVDA,TSLA,META
AI_REVIEW=false

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
MAX_OPEN_POSITIONS=2
TRADE_COOLDOWN_SECONDS=120
DAILY_MAX_LOSS=250
REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5

OPENING_IMPULSE_START_MINUTE=0
OPENING_IMPULSE_END_MINUTE=360
OPENING_IMPULSE_WINDOW_SECONDS=60
OPENING_IMPULSE_MIN_QUOTES=10
OPENING_IMPULSE_CHANGE_PCT=0.003
OPENING_IMPULSE_SKIP_EXTENDED_PCT=0.03
OPENING_IMPULSE_VOLUME_RATIO=2.5
OPENING_IMPULSE_MAX_SPREAD_BPS=20
OPENING_IMPULSE_MIN_QUOTE_SIZE=25
OPENING_IMPULSE_MAX_NEGATIVE_STEPS=3
OPENING_IMPULSE_EXIT_WINDOW_SECONDS=20
OPENING_IMPULSE_EXIT_MIN_QUOTES=6
OPENING_IMPULSE_EXIT_NEGATIVE_STEPS=3
OPENING_IMPULSE_MIN_HOLD_SECONDS=30
OPENING_IMPULSE_STALL_BUFFER_PCT=0.0003
OPENING_IMPULSE_RETRACE_FROM_HIGH_PCT=0.003

OPENING_IMPULSE_BAR_CONFIRMATION=true
OPENING_IMPULSE_BAR_WINDOW=3
OPENING_IMPULSE_BAR_MIN_RISING=2
OPENING_IMPULSE_BAR_CHANGE_PCT=0.003
OPENING_IMPULSE_BAR_VOLUME_RATIO=1.5
