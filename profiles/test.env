# ALPACA_TRADING_BASE_URL=http://127.0.0.1:19901
# ALPACA_DATA_BASE_URL=http://127.0.0.1:19902
ALPACA_API_KEY=test
ALPACA_SECRET_KEY=test
ALPACA_MARKET_DATA_MODE=rest   # avoids real Alpaca websockets

###############################################################################
# Runtime
###############################################################################

EXECUTION_MODE=alpaca_paper
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
AI_REVIEW=false

# Default replay poll. Use 0.5 for high-resolution replay verification.
ALPACA_MARKET_DATA_POLL_SECONDS=1
REPLAY_MARKET_DATA=true
REPLAY_USE_MOCK_CLOCK=true
REPLAY_CLOSED_BARS_ONLY=true
REPLAY_CLOCK_TIMEOUT_SECONDS=0.5

#SYMBOLS=INTC
SYMBOLS=BAC,KRE,XLF
DYNAMIC_EXECUTION_SELECTOR_ENABLED=false

###############################################################################
# Global Targets And Risk
###############################################################################

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.005
MAX_HOLD_SECONDS=420

STARTING_CASH=100000
MAX_POSITION_VALUE=2500
POSITION_SIZING_MODE=fixed_value
RISK_PER_TRADE_PCT=0.005
MAX_TRADE_LOSS_R=1.2
MAX_OPEN_POSITIONS=64
TRADE_COOLDOWN_SECONDS=120

DAILY_MAX_LOSS=250
DAILY_MAX_LOSS_PCT=0.02

#MARKET_REGIME_BYPASS_STRATEGIES=steady_intraday,macd_early_impulse,stoch_macd_reversal
###############################################################################
# Session And Execution Controls
###############################################################################

REGULAR_MARKET_ONLY=true
FLATTEN_BEFORE_CLOSE_MINUTES=15
HEARTBEAT_SECONDS=5
ALPACA_FILL_TIMEOUT_SECONDS=5
MAX_ENTRY_CHASE_PCT=0.003

###############################################################################
# Strategy: liquidity_scalper (replay test — full regular session)
# Minutes elapsed since 09:30 ET. 390 = 16:00 ET close.
###############################################################################

LIQUIDITY_SCALPER_START_MINUTE=0
LIQUIDITY_SCALPER_END_MINUTE=390
LIQUIDITY_SCALPER_AFTERNOON_START_MINUTE=0
LIQUIDITY_SCALPER_AFTERNOON_END_MINUTE=390

###############################################################################
# Per-Strategy Risk Overrides
###############################################################################

# Leave unset or 0 to use the global MAX_POSITION_VALUE, MAX_OPEN_POSITIONS,
# MAX_HOLD_SECONDS, and TRADE_COOLDOWN_SECONDS.
STOCH_MACD_MAX_OPEN_POSITIONS=10
STOCH_MACD_MAX_POSITION_VALUE=5000
STOCH_MACD_MAX_HOLD_SECONDS=420

MACD_MAX_OPEN_POSITIONS=10
MACD_MAX_POSITION_VALUE=5000
MACD_MAX_HOLD_SECONDS=420
# MACD_TRADE_COOLDOWN_SECONDS=0

STEADY_INTRADAY_MAX_OPEN_POSITIONS=10
STEADY_INTRADAY_MAX_POSITION_VALUE=5000
STEADY_INTRADAY_MAX_HOLD_SECONDS=1200
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0

BP_MAX_OPEN_POSITIONS=10
BP_MAX_POSITION_VALUE=5000
BP_MAX_HOLD_SECONDS=25000

# For Paper Trading
# Include pre-open (negative elapsed) through late evening
OPENING_IMPULSE_START_MINUTE=0
OPENING_IMPULSE_END_MINUTE=360

EGC_MAX_HOLD_SECONDS=25000

###############################################################################
# Strategy: stoch_macd_reversal
###############################################################################

# Entry/filter defaults live in config.py (st_paper_0 / stocktrader-1.1 tuning).
# STOCH_MACD_START_MINUTE=0
# STOCH_MACD_MAX_SPREAD_BPS=20
# STOCH_MACD_SUPERTREND_BUFFER_PCT=0.0005
# STOCH_MACD_MIN_VOLUME_RATIO=0.20
# STOCH_MACD_REENTRY_MAX_K=84
# STOCH_MACD_REENTRY_MAX_SUPPORT_EXTENSION_PCT=0.0045
# STOCH_MACD_ALLOW_OVERBOUGHT_EXPANSION=false
# STOCH_MACD_AO_FILTER_ENABLED=true
# STOCH_MACD_AO_FAST_PERIOD=5
# STOCH_MACD_AO_SLOW_PERIOD=34
# STOCH_MACD_AO_RISE_BARS=2
# STOCH_MACD_AO_MIN_VALUE=0.0

# Replay overrides (differ from code defaults).
# STOCH_MACD_REQUIRE_REGULAR_SUPERTREND=false
STOCH_MACD_SYMBOL_LOSS_LOCK_COUNT=10
STOCH_MACD_MAX_TRADES_PER_SYMBOL_PER_SESSION=10
STOCH_MACD_STOCH_CROSS_LOOKBACK_BARS=5

# Use SuperTrend 10,2 as the default tested stoch filter.
STOCH_MACD_SUPERTREND_PERIOD=10
STOCH_MACD_SUPERTREND_MULTIPLIER=2.0
STOCH_MACD_SUPERTREND_CROSS_EMA_PERIOD=20
STOCH_MACD_SUPERTREND_PRE_EMA_CROSS_MULTIPLIER=2.0
STOCH_MACD_VWAP_RISING_LOOKBACK_BARS=3
STOCH_MACD_MIN_VWAP_RISE_BPS=1.0

# STOCH_MACD_STOP_GRACE_SECONDS=20
# STOCH_MACD_STOP_CONFIRMATIONS=2
# STOCH_MACD_STOP_MAX_SPREAD_BPS=30

###############################################################################
# Strategy: mace_early_impulse
###############################################################################

MACD_SYMBOL_LOSS_LOCK_COUNT=3
MACD_MAX_TRADES_PER_SYMBOL_PER_SESSION=4

MACD_BURST_MAX_ENTRIES=1
MACD_BURST_WINDOW_SECONDS=300
MACD_REQUIRE_VWAP_RISING=true
MACD_VWAP_RISING_LOOKBACK_BARS=3
MACD_MIN_VWAP_RISE_BPS=1.0

###############################################################################
# Strategy: steady_intraday
###############################################################################

STEADY_INTRADAY_SYMBOL_LOSS_LOCK_COUNT=10
STEADY_INTRADAY_MAX_TRADES_PER_SYMBOL_PER_SESSION=10

# 0 is proven better than 0.75 and 1.0
# STEADY_INTRADAY_RUNNER_ATR_MULTIPLE=0

###############################################################################
# Strategy: breakout_power
###############################################################################

# Strategy logic defaults live in config.py / breakout_power env_specs.
# Replay risk: long BP_MAX_HOLD_SECONDS avoids global 420s max-hold cuts.
# BP_GREEN_THRESHOLD=70
# BP_MAX_SPREAD_BPS=6
# BP_TREND_LINE=51
# BP_HOLD_FLOOR=46
# BP_DECLINE_GRACE_BARS=1
# BP_DOUBLE_DECLINE_ENABLED=true
# BP_DOUBLE_DECLINE_COUNT=2
# BP_PARTIAL_R=0.8
# BP_PARTIAL_PROFIT_PCT=0.008
# BP_PARTIAL_SIZE=0.60
# BP_SUPERTREND_EXIT_ENABLED=true
# BP_EMA_BEARISH_EXIT_ENABLED=true
# BP_SUPERTREND_PERIOD=10
# BP_SUPERTREND_MULTIPLIER=2.0
# BP_STOP_LOSS_PCT=0.0042
# BP_MIN_HOLD_SECONDS=120
# BP_MAX_TRADES_PER_SYMBOL_PER_SESSION=2
# BP_SYMBOL_LOSS_LOCK_COUNT=1
# BP_RESPECT_CONSECUTIVE_LOSS_LIMITS=true

BP_EMA_BEARISH_EXIT_ENABLED=true
