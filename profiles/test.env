# ALPACA_TRADING_BASE_URL=http://127.0.0.1:19901
# ALPACA_DATA_BASE_URL=http://127.0.0.1:19902
ALPACA_API_KEY=test
ALPACA_SECRET_KEY=test

###############################################################################
# Runtime
###############################################################################

EXECUTION_MODE=alpaca_paper

# Default replay poll. Use 0.5 for high-resolution replay verification.
# ALPACA_MARKET_DATA_POLL_SECONDS=0.5
REPLAY_MARKET_DATA=true
REPLAY_USE_MOCK_CLOCK=true
REPLAY_CLOSED_BARS_ONLY=true

###############################################################################
# Global Targets And Risk
###############################################################################

MAX_HOLD_SECONDS=420

STARTING_CASH=100000
MAX_OPEN_POSITIONS=64
TRADE_COOLDOWN_SECONDS=120

#MARKET_REGIME_BYPASS_STRATEGIES=steady_intraday,macd_early_impulse,stoch_macd_reversal
###############################################################################
# Per-Strategy Risk Overrides
###############################################################################

# Leave unset or 0 to use the global MAX_POSITION_VALUE, MAX_OPEN_POSITIONS,
# MAX_HOLD_SECONDS, and TRADE_COOLDOWN_SECONDS.
STOCH_MACD_MAX_OPEN_POSITIONS=10
STOCH_MACD_MAX_POSITION_VALUE=5000
STOCH_MACD_MAX_HOLD_SECONDS=420

MACD_MAX_OPEN_POSITIONS=10
MACD_MAX_POSITION_VALUE=5000
MACD_MAX_HOLD_SECONDS=420
MACD_TRADE_COOLDOWN_SECONDS=180

STEADY_INTRADAY_MAX_OPEN_POSITIONS=10
STEADY_INTRADAY_MAX_POSITION_VALUE=5000
STEADY_INTRADAY_MAX_HOLD_SECONDS=1200
# STEADY_INTRADAY_TRADE_COOLDOWN_SECONDS=0

BP_MAX_OPEN_POSITIONS=10
BP_MAX_POSITION_VALUE=5000
BP_MAX_HOLD_SECONDS=25000

EGC_MAX_HOLD_SECONDS=25000
