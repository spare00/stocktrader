ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
EXECUTION_MODE=local
STRATEGIES=spike

OPENAI_API_KEY=your_openai_key

SYMBOLS=AAPL,MSFT,NVDA,TSLA,META
AI_REVIEW=false

SPIKE_LOOKBACK_SECONDS=5
SPIKE_CHANGE_PCT=0.0025
VOLUME_RATIO=2.0
MAX_SPREAD_BPS=12

TARGET_PROFIT_PCT=0.01
STOP_LOSS_PCT=0.004
MAX_HOLD_SECONDS=180

STARTING_CASH=25000
MAX_POSITION_VALUE=2500
MAX_OPEN_POSITIONS=3
TRADE_COOLDOWN_SECONDS=30
DAILY_MAX_LOSS=250

OPENING_IMPULSE_CHANGE_PCT=0.01
OPENING_IMPULSE_START_MINUTE=0
OPENING_IMPULSE_END_MINUTE=90
OPENING_IMPULSE_WINDOW_SECONDS=45
OPENING_IMPULSE_MIN_QUOTES=8
OPENING_IMPULSE_SKIP_EXTENDED_PCT=0.05
OPENING_IMPULSE_VOLUME_RATIO=2.0
OPENING_IMPULSE_MAX_SPREAD_BPS=10
OPENING_IMPULSE_MIN_QUOTE_SIZE=10
OPENING_IMPULSE_MAX_NEGATIVE_STEPS=2
OPENING_IMPULSE_EXIT_WINDOW_SECONDS=15
OPENING_IMPULSE_EXIT_MIN_QUOTES=4
OPENING_IMPULSE_EXIT_NEGATIVE_STEPS=2
OPENING_IMPULSE_STALL_BUFFER_PCT=0.0005
