# Alpaca account (paper or live)
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret

# Open AI
OPENAI_API_KEY=your_openai_key

# --- Local mock server instance ---
# Copy `.env.example` to `.env` once per machine/instance, then uncomment this block
# instead of the paper keys above. Point the Alpaca SDK at alpaca_mock_server; keep
# EXECUTION_MODE=alpaca_paper in profiles/paper.env so orders use the same client path.
# ALPACA_TRADING_BASE_URL=http://127.0.0.1:19901
# ALPACA_DATA_BASE_URL=http://127.0.0.1:19902
# ALPACA_STREAM_URL=ws://127.0.0.1:19902/v2/iex
# ALPACA_API_KEY=test
# ALPACA_SECRET_KEY=test
# REPLAY_MARKET_DATA=true
# REPLAY_USE_MOCK_CLOCK=true
# REPLAY_CLOSED_BARS_ONLY=true
# Default replay poll. Use 0.5 for high-resolution replay verification.
# ALPACA_MARKET_DATA_POLL_SECONDS=0.5

# Paper runs: leave mock URLs unset. If they were exported in the shell, unset here:
# unset ALPACA_TRADING_BASE_URL
# unset ALPACA_DATA_BASE_URL
# unset ALPACA_STREAM_URL

# Use `main.py --strategy ...` for one-off runs, or set STRATEGIES here/profile.
# If neither is set, the runner prompts for a strategy.
# STRATEGIES=opening_impulse
# STRATEGIES=macd_early_impulse,stoch_macd_reversal

# Optional local machine overrides. Shared trading tunables belong in
# `profiles/paper.env` or `profiles/live.env`.
# ALPACA_MARKET_DATA_POLL_SECONDS=5

# Optional runtime dynamic selector: subscribe to the top symbols from
# data/opening_universe.txt and add one to the global strategy universe when
# rolling execution strength crosses 120% while it is in the top dollar-volume
# group. This automatically uses effective stream mode because it needs trade ticks.
# DYNAMIC_EXECUTION_SELECTOR_ENABLED=false
# DYNAMIC_EXECUTION_SELECTOR_UNIVERSE_FILE=data/opening_universe.txt
# DYNAMIC_EXECUTION_SELECTOR_CANDIDATE_LIMIT=100
# DYNAMIC_EXECUTION_SELECTOR_TOP_DOLLAR_VOLUME_COUNT=30
# DYNAMIC_EXECUTION_SELECTOR_STRENGTH_THRESHOLD=120
# DYNAMIC_EXECUTION_SELECTOR_LOOKBACK_SECONDS=60
# DYNAMIC_EXECUTION_SELECTOR_MIN_DOLLAR_VOLUME=500000
# DYNAMIC_EXECUTION_SELECTOR_COOLDOWN_SECONDS=600

# Dynamic mover promotion for liquidity_scalper-style intraday expansion.
# Candidates start from a constrained universe and are promoted only after
# recent move, dollar volume, RVOL, spread, cooldown, and stream channel checks.
# DYNAMIC_MOVER_ENABLED=true
# DYNAMIC_MOVER_UNIVERSE_FILE=data/dynamic_mover_universe.txt
# DYNAMIC_MOVER_LOOKBACK_MINUTES=5
# DYNAMIC_MOVER_MIN_MOVE_PCT=0.02
# DYNAMIC_MOVER_MIN_DOLLAR_VOLUME=1000000
# DYNAMIC_MOVER_MIN_RVOL=3.0
# DYNAMIC_MOVER_MAX_SPREAD_BPS=80
# DYNAMIC_MOVER_COOLDOWN_SECONDS=1800
# DYNAMIC_MOVER_MAX_DYNAMIC_SYMBOLS=10
# DYNAMIC_MOVER_SYMBOL_TTL_MINUTES=30

# Optional runtime news expansion. When enabled, runtime automatically uses
# websocket stream mode so news events can add hot symbols to the global universe.
# NEWS_DYNAMIC_SYMBOLS_ENABLED=false
